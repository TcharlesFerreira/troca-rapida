# Copie para .env e preencha (ou rode: npm run setup:env, que gera tudo com valores aleatórios).
# O arquivo .env NUNCA vai para o git.

# --- Banco local (usado pelo docker-compose.yml) ---
POSTGRES_USER=troca
POSTGRES_PASSWORD=
POSTGRES_DB=troca_rapida
DB_PORT=5432

# --- Conexão do app com o banco (na nuvem, só este endereço muda) ---
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL=

# --- Login (Auth.js) ---
# Gere com: openssl rand -base64 32
AUTH_SECRET=
# Na nuvem (Vercel, AWS...) use true se o provedor não definir o host sozinho
# AUTH_TRUST_HOST=true

# --- Primeiro administrador (lido só pelo seed) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
